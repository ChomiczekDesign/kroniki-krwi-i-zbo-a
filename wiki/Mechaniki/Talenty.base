filters:
  and:
    - file.inFolder("Mechaniki/Talenty")
    - file.ext == "md"
properties:
  file.name:
    displayName: Talent

views:
  - type: table
    name: Table
    order:
      - file.name
      - Tier
      - Typ
      - Ranked
      - Aktywacja
    sort:
      - property: Tier
        direction: DESC
      - property: Typ
        direction: DESC
