filters:
  and:
    - file.inFolder("Mechaniki/Talenty")
    - file.ext = "md"
views:
  - type: table
    name: Table
    order:
      - file.name
      - Typ
      - Tier
      - Ranked
      - Aktywacja
    sort:
      - property: Tier
        direction: DESC
      - property: Typ
        direction: DESC
